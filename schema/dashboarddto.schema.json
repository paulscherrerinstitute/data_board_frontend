{
  "$ref": "#/definitions/DashboardDTO",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AxisAssignment": {
      "anyOf": [
        {
          "$ref": "#/definitions/YAxisAssignment"
        },
        {
          "const": "x",
          "type": "string"
        }
      ]
    },
    "AxisLimit": {
      "type": [
        "number",
        "null"
      ]
    },
    "AxisType": {
      "enum": [
        "-",
        "linear",
        "log",
        "date",
        "category",
        "multicategory"
      ],
      "type": "string"
    },
    "Channel": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "seriesId": {
          "type": "string"
        },
        "shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "backend",
        "name",
        "seriesId",
        "source",
        "type",
        "shape",
        "unit",
        "description"
      ],
      "type": "object"
    },
    "CurveAttributes": {
      "additionalProperties": false,
      "properties": {
        "axisAssignment": {
          "$ref": "#/definitions/AxisAssignment"
        },
        "channel": {
          "$ref": "#/definitions/Channel"
        },
        "color": {
          "type": "string"
        },
        "curveMode": {
          "enum": [
            "lines",
            "markers",
            "text",
            "lines+markers",
            "text+markers",
            "text+lines",
            "text+lines+markers",
            "none",
            "gauge",
            "number",
            "delta",
            "number+delta",
            "gauge+number",
            "gauge+number+delta",
            "gauge+delta"
          ],
          "type": "string"
        },
        "curveShape": {
          "enum": [
            "linear",
            "spline",
            "hv",
            "vh",
            "hvh",
            "vhv"
          ],
          "type": "string"
        },
        "displayLabel": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "displayLabel",
        "axisAssignment"
      ],
      "type": "object"
    },
    "Dashboard": {
      "additionalProperties": false,
      "properties": {
        "widgets": {
          "items": {
            "$ref": "#/definitions/Widget"
          },
          "type": "array"
        }
      },
      "required": [
        "widgets"
      ],
      "type": "object"
    },
    "DashboardDTO": {
      "additionalProperties": false,
      "properties": {
        "dashboard": {
          "$ref": "#/definitions/Dashboard"
        }
      },
      "required": [
        "dashboard"
      ],
      "type": "object"
    },
    "StoredPlotSettings": {
      "additionalProperties": false,
      "properties": {
        "curveAttributes": {
          "additionalProperties": {
            "$ref": "#/definitions/CurveAttributes"
          },
          "type": "object"
        },
        "manualAxisAssignment": {
          "type": "boolean"
        },
        "plotTitle": {
          "type": "string"
        },
        "yAxisAttributes": {
          "items": {
            "$ref": "#/definitions/YAxisAttributes"
          },
          "type": "array"
        }
      },
      "required": [
        "curveAttributes",
        "manualAxisAssignment",
        "plotTitle",
        "yAxisAttributes"
      ],
      "type": "object"
    },
    "Widget": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "$ref": "#/definitions/Channel"
          },
          "type": "array"
        },
        "layout": {
          "additionalProperties": false,
          "description": "A single item in the grid layout.\n\nPosition (x, y) is in grid units, not pixels. Size (w, h) is in grid units.",
          "properties": {
            "constraints": {
              "description": "Per-item layout constraints. Applied in addition to grid-level constraints.",
              "items": {
                "additionalProperties": false,
                "description": "Interface for layout constraints.\n\nImplement this interface to create custom position/size constraints. Built-in constraints: gridBounds, minMaxSize, containerBounds, boundedX, boundedY.",
                "properties": {
                  "name": {
                    "description": "Constraint identifier for debugging",
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "h": {
              "description": "Height in grid units",
              "type": "number"
            },
            "i": {
              "description": "Unique identifier for this item",
              "type": "string"
            },
            "isBounded": {
              "description": "If true, item is constrained to the grid container bounds. Overrides grid-level isBounded for this item.",
              "type": "boolean"
            },
            "isDraggable": {
              "description": "If false, item cannot be dragged (but may still be resizable). Overrides grid-level isDraggable for this item.",
              "type": "boolean"
            },
            "isResizable": {
              "description": "If false, item cannot be resized (but may still be draggable). Overrides grid-level isResizable for this item.",
              "type": "boolean"
            },
            "maxH": {
              "description": "Maximum height in grid units",
              "type": "number"
            },
            "maxW": {
              "description": "Maximum width in grid units",
              "type": "number"
            },
            "minH": {
              "description": "Minimum height in grid units",
              "type": "number"
            },
            "minW": {
              "description": "Minimum width in grid units",
              "type": "number"
            },
            "moved": {
              "description": "Internal flag set during drag/resize operations to indicate the item has moved from its original position.",
              "type": "boolean"
            },
            "resizeHandles": {
              "description": "Which resize handles to show for this item. Overrides grid-level resizeHandles for this item.",
              "items": {
                "description": "Axis identifiers for resize handles.\n- Cardinal: 'n', 's', 'e', 'w' (north, south, east, west)\n- Diagonal: 'ne', 'nw', 'se', 'sw'",
                "enum": [
                  "s",
                  "w",
                  "e",
                  "n",
                  "sw",
                  "nw",
                  "se",
                  "ne"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "static": {
              "description": "If true, item cannot be dragged or resized, and other items will move around it during compaction.",
              "type": "boolean"
            },
            "w": {
              "description": "Width in grid units",
              "type": "number"
            },
            "x": {
              "description": "X position in grid units (0-indexed from left)",
              "type": "number"
            },
            "y": {
              "description": "Y position in grid units (0-indexed from top)",
              "type": "number"
            }
          },
          "required": [
            "i",
            "x",
            "y",
            "w",
            "h"
          ],
          "type": "object"
        },
        "plotSettings": {
          "$ref": "#/definitions/StoredPlotSettings"
        }
      },
      "required": [
        "channels",
        "layout"
      ],
      "type": "object"
    },
    "YAxisAssignment": {
      "enum": [
        "y1",
        "y2",
        "y3",
        "y4"
      ],
      "type": "string"
    },
    "YAxisAttributes": {
      "additionalProperties": false,
      "properties": {
        "displayLabel": {
          "type": "string"
        },
        "label": {
          "$ref": "#/definitions/YAxisAssignment"
        },
        "manualDisplayLabel": {
          "type": "boolean"
        },
        "max": {
          "$ref": "#/definitions/AxisLimit"
        },
        "min": {
          "$ref": "#/definitions/AxisLimit"
        },
        "scaling": {
          "$ref": "#/definitions/AxisType"
        }
      },
      "required": [
        "label",
        "min",
        "max",
        "displayLabel",
        "manualDisplayLabel"
      ],
      "type": "object"
    }
  }
}